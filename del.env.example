# Google AI Studio
# The project guide uses GOOGLE_API_KEY.
GOOGLE_API_KEY=

# Gemini models
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_BACKUP_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Pinecone
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_WEBSITE_INDEX=bq-website-knowledge
PINECONE_CURRICULUM_INDEX=bq-curriculum-knowledge
PINECONE_WEBSITE_NAMESPACE=website
PINECONE_CURRICULUM_NAMESPACE=curriculum

# Retrieval
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# Gemini Free-Tier safety controls from the project guide
GEMINI_CHAT_DELAY_SECONDS=3
GEMINI_EMBED_DELAY_SECONDS=5
GEMINI_429_COOLDOWN_SECONDS=60
GEMINI_CHAT_RPM=15
GEMINI_CHAT_RPD=500
GEMINI_EMBEDDING_RPM=100
GEMINI_EMBEDDING_RPD=1000
GEMINI_MAX_RETRIES=2

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_TIMEZONE=Asia/Karachi
