
cat > .devcontainer/devcontainer.json <<'EOF'
{
  // Give the Codespace a recognizable name in the development environment.
  "name": "Bano Qabil AI Service Desk",

  // Use the official Microsoft Dev Container Python image with Python 3.13.
  // The project itself also pins Python 3.13.5 through .python-version.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",

  // Run the development environment as the normal non-root vscode user.
  "remoteUser": "vscode",

  // Add Git support to the development container.
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Run our repository-controlled setup script after the container is created.
  // This makes the pinned uv installation reproducible for future Codespaces.
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
EOF